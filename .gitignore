# ============================================================
# 1) 密钥 / 凭据 —— 绝对不能进仓库
#    config/okx_creds.json 里是真实的 OKX api_key / secret_key / passphrase
# ============================================================
config/okx_creds.json
config/*creds*.json
config/*secret*.json
!config/okx_creds.example.json
# config/notify.json 里是 webhook 地址 —— 这些服务的凭据就在 query string 里
config/notify.json
config/*notify*.json
!config/notify.example.json
*.env
.env
.env.*
*.pem
*.key
.netrc

# ============================================================
# 2) 实时交易账本 / 订单 / 成交（含账户状态、clOrdId、资金曲线）
# ============================================================
artifacts/live/

# ============================================================
# 3) 大数据产物（可复算，或需重新下载）
#    artifacts/ 692M（baseline.pkl / charts / 各 tag 的 CSV）
#    data_cache/ 305M（K 线 + 资金费缓存，跑 download/funding_build 可重建）
#    data_cache_binance/ 188M（同一份管线换币安行情，见 FINDINGS Q40）
#    但保留 artifacts/ 顶层的三份交付文档
# ============================================================
# `data_cache*/` 而不是 `data_cache/`：换场所跑一次就会多出一个 data_cache_<venue>/，
# 漏掉一个就是 188M 的 parquet 直接进仓库（`git status` 只报目录名，不报体积）。
data_cache*/
artifacts/**
!artifacts/*.md

# ============================================================
# 4) 运行期 / 缓存 / 日志
# ============================================================
.pytest_cache/
.pytest_tmp/
__pycache__/
*.py[cod]
*.egg-info/
logs/
_pyprocs.txt
.empty_netrc
*.log

# ============================================================
# 5) 本机工作目录（agent 记忆与上下文，不进仓库）
# ============================================================
.workbuddy/

# ============================================================
# 6) 操作系统
# ============================================================
.DS_Store
Thumbs.db
